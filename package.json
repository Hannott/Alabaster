{
  "name": "alabaster",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "check": "npm run format:check && npm run lint && npm run type-check && npm run test && vite build",
    "docker:up": "docker compose --file compose.dev.yaml up --build --detach",
    "docker:down": "docker compose --file compose.dev.yaml down",
    "docker:logs": "docker compose --file compose.dev.yaml logs --follow web"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "hls.js": "^1.7.1",
    "jmuxer": "^2.1.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}

{
  "extends": ["@vue/tsconfig/tsconfig.json"],
  "include": [
    "vite.config.ts",
    "eslint.config.js",
    "website/.vitepress/config.ts",
    "src/env.d.ts",
    "src/**/__tests__/*.ts",
    "klipper/__tests__/*.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
